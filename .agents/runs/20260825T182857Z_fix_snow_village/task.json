{
  "version": 1,
  "id": "fix_snow_village",
  "task": "Bring Snow Village to the requested 16x16 Boom map contract without changing other maps, gameplay rules, networking, save/account data or economy behavior. This sample requests 104 breakables as a future product contract; the current production gate expects 128, so run it only after confirming that product-direction change.",
  "mode": "implementation",
  "scope": [
    "scripts/maps/MapLayoutBuilder.gd",
    "assets/visual_overhaul_v2/maps/snow_village/**"
  ],
  "protected_paths": [
    "scripts/network/**",
    "scripts/data/**",
    "data/database/**",
    "scripts/core/GameSession.gd",
    "scripts/match/**",
    "scripts/player/**",
    "tests/**",
    "project.godot",
    "export_presets.cfg"
  ],
  "allowed_output_paths": [
    "tests/artifacts/**"
  ],
  "acceptance_criteria": [
    {
      "id": "snow_map_contract",
      "description": "Snow Village is 16x16 with authored 40x40 cells, exactly 104 breakables, a complete central 4x4 breakable field, safe spawns, four-way symmetry and a hard outer border.",
      "type": "map_contract",
      "map_id": "snow_village",
      "width": 16,
      "height": 16,
      "tile_size": 40,
      "breakables": 104,
      "center": {
        "origin": [
          6,
          6
        ],
        "size": [
          4,
          4
        ],
        "allowed_tile_types": [
          2
        ]
      },
      "spawn_safe_cells": 3,
      "four_way_symmetry": true,
      "hard_border": true,
      "validator_ids": [
        "map_contract"
      ]
    },
    {
      "id": "map_seams",
      "description": "V2 map border assets join without transparent or edge seams and a fresh Snow Village capture exists.",
      "validator_ids": [
        "visual_asset_seams",
        "tileset_capture"
      ]
    },
    {
      "id": "bomb_and_collision",
      "description": "Water burst, breakable collision, balloon exit and item-drop regression checks pass.",
      "validator_ids": [
        "map_gameplay",
        "balloon_collision"
      ]
    }
  ],
  "validators": [
    {
      "id": "godot_import",
      "type": "godot_import",
      "required": true,
      "timeout_seconds": 300,
      "fail_on_log_regex": "Parse Error|SCRIPT ERROR"
    },
    {
      "id": "map_contract",
      "type": "map_contract",
      "required": true,
      "timeout_seconds": 180
    },
    {
      "id": "visual_asset_seams",
      "type": "command",
      "required": true,
      "command": [
        "{python}",
        "tools/validate_map_visual_assets.py"
      ],
      "timeout_seconds": 180,
      "success_regex": "VISUAL_ASSET_RESULT: .* 0 failed"
    },
    {
      "id": "map_gameplay",
      "type": "godot_scene",
      "required": true,
      "scene": "res://tests/MapGameplayRegressionSmoke.tscn",
      "timeout_seconds": 240,
      "success_regex": "MAP_GAMEPLAY_REGRESSION_RESULT: .* 0 failed"
    },
    {
      "id": "balloon_collision",
      "type": "godot_scene",
      "required": true,
      "scene": "res://tests/BalloonExitAndCollisionSmoke.tscn",
      "timeout_seconds": 240,
      "success_regex": "BALLOON_EXIT_COLLISION_RESULT: .* 0 failed"
    },
    {
      "id": "tileset_capture",
      "type": "godot_scene",
      "required": true,
      "renderer": "gpu",
      "scene": "res://tests/TilesetVisualCapture.tscn",
      "timeout_seconds": 300
    }
  ],
  "screenshots": [
    {
      "source": "tests/artifacts/tileset_validation/map_snow_village.png",
      "label": "Snow Village runtime",
      "required": true
    }
  ],
  "worker": {
    "mode": "auto",
    "timeout_seconds": 1800,
    "shared_file_timeout_seconds": 180
  },
  "max_iterations": 5
}
