; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Boom"
run/main_scene="res://scenes/login/Login.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/game_icon.png"

[autoload]

EventBus="*res://scripts/core/EventBus.gd"
CosmeticRegistry="*res://scripts/cosmetics/CosmeticRegistry.gd"
AccountDatabase="*res://scripts/data/AccountDatabase.gd"
SoundManager="*res://scripts/utilities/SoundManager.gd"
ExitSequence="*res://scripts/core/ExitSequence.gd"
NetworkManager="*res://scripts/network/NetworkManager.gd"
RoomManager="*res://scripts/network/RoomManager.gd"
GameSession="*res://scripts/core/GameSession.gd"
PlayerEquipmentService="*res://scripts/cosmetics/PlayerEquipmentService.gd"
SettingsStore="*res://scripts/core/SettingsStore.gd"
WaterBalloonSkinRegistry="*res://scripts/water_balloon/WaterBalloonSkinRegistry.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")

[gui]

theme/custom="res://resources/ui/game_theme.tres"

