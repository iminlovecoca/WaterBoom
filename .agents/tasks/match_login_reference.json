{
  "version": 1,
  "id": "match_login_reference",
  "task": "Match the login UI to the approved reference while preserving the Aqua Arcade theme, responsive layout, focus behavior, authentication/network routing and all gameplay/save contracts. Use the reference image supplied to the worker and make only measured layout/asset changes.",
  "mode": "implementation",
  "scope": [
    "scenes/login/Login.tscn",
    "scripts/ui/LoginScreen.gd",
    "assets/ui/login/**",
    "resources/ui/game_theme.tres"
  ],
  "protected_paths": [
    "scripts/network/**",
    "scripts/data/**",
    "data/database/**",
    "scripts/core/GameSession.gd",
    "scripts/match/**",
    "scripts/player/**",
    "tests/**",
    "project.godot",
    "export_presets.cfg"
  ],
  "allowed_output_paths": [
    "tests/artifacts/**"
  ],
  "acceptance_criteria": [
    {
      "id": "login_layout_contract",
      "description": "Required controls/assets exist; title, panel and buttons stay inside all target viewports; panel and title do not overlap; buttons keep 100x44 minimum targets and the vertical gap stays within the approved range.",
      "type": "ui_layout_contract",
      "scene": "res://scenes/login/Login.tscn",
      "viewports": [[760, 570], [960, 720], [1280, 720], [1280, 960], [1440, 1080]],
      "required_assets": [
        "res://assets/ui/login/login_world_v1.png",
        "res://resources/ui/game_theme.tres"
      ],
      "nodes": [
        {"path": "SafeArea/Flow/Title", "inside_viewport": true},
        {"path": "SafeArea/Flow/Subtitle", "inside_viewport": true},
        {"path": "SafeArea/Flow/PanelCenter/LoginPanel", "inside_viewport": true, "min_width": 320, "min_height": 300},
        {"path": "SafeArea/Flow/PanelCenter/LoginPanel/VBox/Buttons/LoginButton", "inside_viewport": true, "min_width": 100, "min_height": 44},
        {"path": "SafeArea/Flow/PanelCenter/LoginPanel/VBox/Buttons/CreateButton", "inside_viewport": true, "min_width": 100, "min_height": 44},
        {"path": "SafeArea/Flow/PanelCenter/LoginPanel/VBox/Buttons/ForgotButton", "inside_viewport": true, "min_width": 100, "min_height": 44}
      ],
      "relations": [
        {
          "id": "title_to_panel",
          "first": "SafeArea/Flow/Title",
          "second": "SafeArea/Flow/PanelCenter/LoginPanel",
          "relation": "vertical_gap",
          "min": 0,
          "max": 600
        }
      ],
      "validator_ids": ["ui_contract", "login_matrix", "login_capture"]
    }
  ],
  "validators": [
    {
      "id": "godot_import",
      "type": "godot_import",
      "required": true,
      "timeout_seconds": 300,
      "fail_on_log_regex": "Parse Error|SCRIPT ERROR"
    },
    {
      "id": "ui_contract",
      "type": "ui_layout_contract",
      "required": true,
      "timeout_seconds": 240
    },
    {
      "id": "login_matrix",
      "type": "godot_scene",
      "required": true,
      "scene": "res://tests/LoginLayoutMatrixSmoke.tscn",
      "timeout_seconds": 240,
      "success_regex": "LOGIN_LAYOUT_MATRIX_RESULT: .* 0 failed"
    },
    {
      "id": "login_capture",
      "type": "godot_scene",
      "required": true,
      "renderer": "gpu",
      "scene": "res://tests/LoginVisualCapture.tscn",
      "timeout_seconds": 240
    }
  ],
  "screenshots": [
    {
      "source": "tests/artifacts/login.png",
      "label": "Login reference comparison",
      "required": true
    }
  ],
  "worker": {
    "mode": "auto",
    "timeout_seconds": 1800,
    "shared_file_timeout_seconds": 180
  },
  "max_iterations": 5
}
