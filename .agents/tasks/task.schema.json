{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.boom.game/agent-task.schema.json",
  "title": "Boom Codex/Antigravity task",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "task", "scope", "protected_paths", "acceptance_criteria", "validators", "max_iterations"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "task": {"type": "string", "minLength": 10},
    "mode": {"enum": ["implementation", "read_only"], "default": "implementation"},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "protected_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_output_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "type": {"type": "string"},
          "validator_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["godot_import", "godot_scene", "command", "file_exists", "map_contract", "ui_layout_contract"]},
          "required": {"type": "boolean", "default": true},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800}
        },
        "additionalProperties": true
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": {"type": "string"},
          "label": {"type": "string"},
          "required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["auto", "subprocess", "pty", "shared_file"]},
        "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 7200},
        "shared_file_timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 86400}
      },
      "additionalProperties": false
    },
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 5}
  }
}
